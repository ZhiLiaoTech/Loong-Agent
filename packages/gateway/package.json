    "@loong/studio": "workspace:*",
    "@loong/core": "workspace:*",
    "@loong/cron": "workspace:*",
    "@loong/model-catalog": "workspace:*",
    "@loong/org": "workspace:*",
    "@loong/suite": "workspace:*",
    "@loong/tools": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
