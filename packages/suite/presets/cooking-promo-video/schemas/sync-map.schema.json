{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loong.cooking-video.sync-map.v1",
  "type": "object",
  "required": ["schemaVersion", "jobId", "referenceCameraId", "method", "confidence", "cameras"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string" },
    "referenceCameraId": { "type": "string" },
    "method": { "enum": ["timecode", "machine_event", "audio_cross_correlation", "manual"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "cameras": { "type": "object", "additionalProperties": { "type": "object", "required": ["offsetMs"], "properties": { "offsetMs": { "type": "integer" } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
