{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loong.cooking-video.vision-response.v1",
  "type": "object",
  "required": ["schemaVersion", "jobId", "detections"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string" },
    "detections": { "type": "array", "items": { "type": "object", "required": ["itemId", "event", "confidence"], "additionalProperties": false, "properties": { "itemId": { "type": "string" }, "event": { "type": "string" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "problems": { "type": "array", "items": { "type": "string" } } } } }
  },
  "additionalProperties": false
}
