{
  "name": "@loong/core",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@loong/providers": "workspace:*",
    "@loong/security": "workspace:*",
    "@loong/tools": "workspace:*"
  },
  "peerDependencies": {
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.7.76",
    "xlsx": "^0.18.5",
    "jszip": "^3.10.1"
  },
  "peerDependenciesMeta": {
    "mammoth": { "optional": true },
    "pdfjs-dist": { "optional": true },
    "xlsx": { "optional": true },
    "jszip": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
