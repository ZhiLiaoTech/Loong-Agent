{
  "name": "@loong/test-suite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "tsx src/index.ts",
    "test:shards": "node scripts/run-shards.mjs"
  },
  "dependencies": {
    "@loong/channels": "workspace:*",
    "@loong/client": "workspace:*",
    "@loong/core": "workspace:*",
    "@loong/cron": "workspace:*",
    "@loong/delegation": "workspace:*",
    "@loong/gateway": "workspace:*",
    "@loong/memory": "workspace:*",
    "@loong/model-catalog": "workspace:*",
    "@loong/providers": "workspace:*",
    "@loong/security": "workspace:*",
    "@loong/suite": "workspace:*",
    "@loong/tools": "workspace:*"
  },
  "devDependencies": {
    "@loong/studio": "workspace:*",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
