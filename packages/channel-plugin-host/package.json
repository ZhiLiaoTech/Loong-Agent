{
  "name": "@loong/channel-plugin-host",
  "version": "0.0.0",
  "description": "Loong Channel Plugin Host — loads OpenClaw-format channel plugins inside loong gateway (single process).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openclaw-compat": {
      "types": "./dist/openclaw-compat/index.d.ts",
      "default": "./dist/openclaw-compat/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@loong/channels": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
