{
  "name": "@loong/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "loong": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@loong/channels": "workspace:*",
    "@loong/core": "workspace:*",
    "@loong/cron": "workspace:*",
    "@loong/delegation": "workspace:*",
    "@loong/gateway": "workspace:*",
    "@loong/memory": "workspace:*",
    "@loong/org": "workspace:*",
    "@loong/model-catalog": "workspace:*",
    "@loong/plugin-sdk": "workspace:*",
    "@loong/providers": "workspace:*",
    "@loong/security": "workspace:*",
    "@loong/skills": "workspace:*",
    "@loong/tools": "workspace:*",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.7.76",
    "xlsx": "^0.18.5",
    "jszip": "^3.10.1",
    "@loong/suite": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
