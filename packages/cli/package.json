{
  "name": "@dragon/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "dragon": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@dragon/core": "workspace:*",
    "@dragon/cron": "workspace:*",
    "@dragon/delegation": "workspace:*",
    "@dragon/gateway": "workspace:*",
    "@dragon/memory": "workspace:*",
    "@dragon/model-catalog": "workspace:*",
    "@dragon/plugin-sdk": "workspace:*",
    "@dragon/providers": "workspace:*",
    "@dragon/security": "workspace:*",
    "@dragon/skills": "workspace:*",
    "@dragon/tools": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
