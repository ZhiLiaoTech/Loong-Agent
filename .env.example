# Loong local deployment example.
# Copy to .env for docker compose or export values in your shell.

# Host port published by docker compose.
LOONG_GATEWAY_PUBLISHED_PORT=8787

# Required when you want protected Gateway runtime endpoints.
# The dashboard page itself can load without this value, then submit it in the UI.
LOONG_GATEWAY_SECRET=change-me-local-secret

# Optional provider configuration for live agent runs.
# The dashboard Models tab can also persist providers here.
# LOONG_MODEL_CONFIG=/data/config/providers.json
# The dashboard Agents tab can persist reusable Agent Profiles here.
# LOONG_AGENT_CONFIG=/data/config/agents.json
# LOONG_OPENAI_API_KEY=
# LOONG_OPENAI_MODEL=gpt-4.1-mini
# LOONG_ANTHROPIC_API_KEY=
# LOONG_ANTHROPIC_MODEL=claude-3-5-haiku-latest
# LOONG_OPENROUTER_API_KEY=
# LOONG_OPENROUTER_MODEL=openai/gpt-4.1-mini

# Optional smoke-test target for an already running Gateway.
# LOONG_SMOKE_GATEWAY_URL=http://127.0.0.1:8787
