{
  "name": "loong-agent-framework",
  "version": "0.0.0",
  "private": true,
  "description": "Loong is a TypeScript-native, local-first agent framework.",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "studio:dev": "corepack pnpm --filter @loong/studio dev",
    "studio:build": "corepack pnpm --filter @loong/studio build",
    "desktop:inspect": "node scripts/package-desktop-release.mjs inspect",
    "desktop:prepare-runtime": "node scripts/package-desktop-release.mjs prepare-runtime",
    "desktop:build": "node scripts/package-desktop-release.mjs build --profile build",
    "desktop:release": "node scripts/package-desktop-release.mjs build --profile release",
    "desktop:publish": "node scripts/package-desktop-release.mjs publish",
    "build": "corepack pnpm -r build",
    "check": "corepack pnpm -r check",
    "clean": "corepack pnpm -r clean",
    "smoke:gateway": "tsx scripts/smoke-gateway.ts",
    "sync:readme-i18n": "node scripts/sync-readme-i18n.mjs",
    "test": "corepack pnpm -r build && corepack pnpm studio:build && corepack pnpm --filter @loong/test-suite test"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "optional": "^0.1.4"
  }
}
